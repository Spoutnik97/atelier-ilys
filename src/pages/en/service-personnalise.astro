---
import BaseLayout from "../../layouts/BaseLayout.astro";

const clients = [
    "Wonderbox",
    "La Cité, Forcalquier",
    "La Thomassine educational farm",
    "Salon-de-Provence Tourist Office",
    "École nationale supérieure des arts décoratifs",
    "Association Brin d'herbe",
    "Forcalquier Media Library",
    "Camilaine",
    "CFPPA Carmejane",
];

const services = [
    {
        icon: "🎨",
        title: "Professional dyeing",
        description:
            "Batch dyeing of textile pieces for designers, stylists and eco-conscious fashion brands. We work with all natural fibres: wool, silk, linen and cotton.",
        examples: [
            "Knitting yarns",
            "Dressmaking fabrics",
            "Fashion accessories",
            "Embroidery threads",
        ],
    },
    {
        icon: "🎤",
        title: "Talks & demonstrations",
        description:
            "Sessions at art schools, museums, festivals and events. An introduction to the history and techniques of plant dyeing, with live demonstrations.",
        examples: [
            "Art and fashion schools",
            "Museums and libraries",
            "Craft festivals",
            "Corporate events",
        ],
    },
    {
        icon: "🏠",
        title: "Workshops at your venue",
        description:
            "Isabelle comes to you to run plant dyeing workshops on your premises. Ideal for businesses, associations, care homes, holiday clubs and private events.",
        examples: [
            "Corporate team building",
            "Care homes and social organisations",
            "Cultural associations",
            "Weddings & events",
        ],
    },
    {
        icon: "📋",
        title: "Consulting & support",
        description:
            "Support for professional projects involving plant dyeing: defining colour palettes, selecting plants, choosing mordants and developing reproducible protocols.",
        examples: [
            "Natural fashion brands",
            "Textile designers",
            "Educational projects",
            "Museums & heritage",
        ],
    },
];
---

<BaseLayout
    title="Bespoke services — Professional dyeing, talks, workshops at your venue"
    description="Atelier Ilys offers bespoke plant dyeing services: professional dyeing, talks, demonstrations, workshops at your venue and consulting. Quotes on request."
    canonicalPath="/en/service-personnalise"
>
    <section class="py-20 bg-cream-dark border-b text-center">
        <div class="max-w-3xl mx-auto px-4">
            <p class="text-ochre text-sm uppercase tracking-widest mb-3">
                Made to measure
            </p>
            <h1 class="section-title text-4xl md:text-5xl">
                Bespoke services
            </h1>
            <p class="section-subtitle">
                Professional dyeing · Talks · Workshops at your venue
            </p>
            <p class="text-warm-text/70 max-w-2xl mx-auto leading-relaxed">
                Do you have a professional project involving plant colours?
                Isabelle puts her expertise at the service of your creative or
                educational ambitions.
            </p>
        </div>
    </section>

    <section class="py-20 bg-cream">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {
                    services.map(({ icon, title, description, examples }) => (
                        <div class="bg-white p-8 rounded-sm shadow-sm border border-cream-dark">
                            <div class="text-3xl mb-4">{icon}</div>
                            <h2 class="font-heading text-xl text-indigo mb-3">
                                {title}
                            </h2>
                            <p class="text-warm-text/70 text-sm leading-relaxed mb-4">
                                {description}
                            </p>
                            <ul class="space-y-1">
                                {examples.map((ex) => (
                                    <li class="text-xs text-warm-text/60 flex gap-2">
                                        <span class="text-ochre">→</span>
                                        {ex}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Clients -->
    <section class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="section-title mb-3">They have trusted us</h2>
            <p class="section-subtitle">References & partners</p>
            <div class="flex flex-wrap justify-center gap-4 mt-8">
                {
                    clients.map((client) => (
                        <span class="px-4 py-2 bg-cream-dark rounded text-sm text-warm-text/70 font-medium">
                            {client}
                        </span>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-ochre text-cream text-center">
        <div class="max-w-2xl mx-auto px-4">
            <h2 class="font-heading text-3xl text-cream mb-4">
                Let's talk about your project
            </h2>
            <p class="text-cream/90 mb-8">
                Every project is unique. Contact us for a free, no-obligation
                personalised quote.
            </p>
            <div class="flex flex-wrap justify-center gap-4">
                <a
                    href="/en/contact"
                    class="btn-primary bg-cream text-ochre hover:bg-cream-dark"
                    >Contact us</a
                >
                <a
                    href="mailto:atelier.ilys@gmail.com"
                    class="btn-secondary border-cream text-cream hover:bg-cream hover:text-ochre"
                >
                    atelier.ilys@gmail.com
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
