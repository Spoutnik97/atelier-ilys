---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StayForm from "../../components/StayForm.astro";
import GoogleMap from "../../components/GoogleMap.astro";
---

<BaseLayout
    title="Book a Stay — Accommodation in Haute-Provence"
    description="Book your stay at Atelier Ilys: cottage, loft or guest room in our silk farm in Pierrerue (Forcalquier), Haute-Provence. Reply within 48 hours."
    canonicalPath="/en/reserve-ton-sejour"
>
    <section class="py-16 bg-cream-dark border-b text-center">
        <div class="max-w-3xl mx-auto px-4">
            <p class="text-ochre text-sm uppercase tracking-widest mb-3">
                Stay booking
            </p>
            <h1 class="section-title text-4xl md:text-5xl">
                Book a stay
            </h1>
            <p class="text-warm-text/70 mt-4 leading-relaxed">
                Fill in the form below and Isabelle will get back to you within
                48 hours to confirm availability.
            </p>
        </div>
    </section>

    <section class="py-16 bg-cream">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                <!-- Form -->
                <div class="lg:col-span-2">
                    <div
                        class="bg-white p-8 rounded-sm shadow-sm border border-cream-dark"
                    >
                        <h2 class="font-heading text-2xl text-indigo mb-6">
                            Your stay request
                        </h2>
                        <StayForm />
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="space-y-6">
                    <div class="bg-indigo text-cream p-6 rounded-sm">
                        <h3 class="font-heading text-lg text-ochre mb-4">
                            Accommodation
                        </h3>
                        <ul class="space-y-2 text-sm text-cream/90">
                            <li class="flex justify-between">
                                <span>Maisonnette (2 guests)</span>
                                <span class="font-semibold">from €110/night</span
                                >
                            </li>
                            <li class="flex justify-between">
                                <span>Grand Pré Loft (12 guests)</span>
                                <span class="font-semibold">from €250/night</span
                                >
                            </li>
                            <li
                                class="flex justify-between border-t border-cream/20 pt-2 mt-2"
                            >
                                <span>Guest rooms (2 guests)</span>
                                <span class="font-semibold">from €80/night</span>
                            </li>
                        </ul>
                        <p class="text-xs text-cream/60 mt-3">
                            Household linen included. Tourist tax not included.
                        </p>
                    </div>

                    <div
                        class="bg-white p-6 rounded-sm shadow-sm border border-cream-dark"
                    >
                        <h3 class="font-heading text-lg text-indigo mb-3">
                            Good to know
                        </h3>
                        <ul class="space-y-2 text-sm text-warm-text/70">
                            <li class="flex gap-2">
                                <span class="text-ochre">✓</span>
                                <span>Check-in: from 3 pm</span>
                            </li>
                            <li class="flex gap-2">
                                <span class="text-ochre">✓</span>
                                <span>Check-out: before 11 am</span>
                            </li>
                            <li class="flex gap-2">
                                <span class="text-ochre">✓</span>
                                <span>Pets welcome on request</span>
                            </li>
                            <li class="flex gap-2">
                                <span class="text-ochre">✓</span>
                                <span>Can be combined with a workshop</span>
                            </li>
                            <li class="flex gap-2">
                                <span class="text-ochre">✓</span>
                                <span>Pool open in season</span>
                            </li>
                        </ul>
                    </div>

                    <div class="bg-cream-dark p-6 rounded-sm">
                        <h3 class="font-heading text-lg text-indigo mb-3">
                            Get in touch directly
                        </h3>
                        <p class="text-sm text-warm-text/70 mb-3">
                            Would you rather give us a call?
                        </p>
                        <a
                            href="tel:+33764443715"
                            class="btn-primary text-sm block text-center mb-2"
                        >
                            +33 7 64 44 37 15
                        </a>
                        <a
                            href="mailto:atelier.ilys@gmail.com"
                            class="btn-secondary text-sm block text-center"
                        >
                            atelier.ilys@gmail.com
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="pb-16 bg-cream">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <GoogleMap height="350px" />
        </div>
    </section>
</BaseLayout>
