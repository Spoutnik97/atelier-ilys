---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookingForm from "../../components/BookingForm.astro";
import GoogleMap from "../../components/GoogleMap.astro";
---

<BaseLayout
    title="Book a Plant-Dyeing Workshop"
    description="Book your plant-dyeing workshop at Atelier Ilys (Pierrerue, Haute-Provence). Indigo, dye plants, eco-print, pigments and family sessions. Reply within 48 hours."
    canonicalPath="/en/reserver"
>
    <section class="py-16 bg-cream-dark border-b text-center">
        <div class="max-w-3xl mx-auto px-4">
            <p class="text-ochre text-sm uppercase tracking-widest mb-3">
                Booking
            </p>
            <h1 class="section-title text-4xl md:text-5xl">
                Book a workshop
            </h1>
            <p class="text-warm-text/70 mt-4 leading-relaxed">
                Fill in the form below and Isabelle will get back to you within
                48 hours to confirm availability and practical details.
            </p>
        </div>
    </section>

    <section class="py-16 bg-cream">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                <!-- Form -->
                <div class="lg:col-span-2">
                    <div
                        class="bg-white p-8 rounded-sm shadow-sm border border-cream-dark"
                    >
                        <h2 class="font-heading text-2xl text-indigo mb-6">
                            Your workshop request
                        </h2>
                        <BookingForm />
                    </div>
                </div>

                <!-- Sidebar info -->
                <div class="space-y-6">
                    <!-- Pricing -->
                    <div class="bg-indigo text-cream p-6 rounded-sm">
                        <h3 class="font-heading text-lg text-ochre mb-4">
                            Prices
                        </h3>
                        <ul class="space-y-2 text-sm text-cream/90">
                            <li class="flex justify-between">
                                <span>Half day</span>
                                <span class="font-semibold">€60</span>
                            </li>
                            <li class="flex justify-between">
                                <span>Full day</span>
                                <span class="font-semibold">€120</span>
                            </li>

                            <li
                                class="flex justify-between border-t border-cream/20 pt-2"
                            >
                                <span>Family session</span>
                                <span class="font-semibold">€40 / adult</span>
                            </li>
                        </ul>
                        <p class="text-xs text-cream/60 mt-3">
                            All materials included. Lunch not included.
                        </p>
                    </div>

                    <!-- Contact info -->
                    <div
                        class="bg-white p-6 rounded-sm shadow-sm border border-cream-dark"
                    >
                        <h3 class="font-heading text-lg text-indigo mb-4">
                            Get in touch directly
                        </h3>
                        <address
                            class="not-italic text-sm text-warm-text/80 space-y-2"
                        >
                            <p>
                                <a
                                    href="tel:+33764443715"
                                    class="flex items-center gap-2 hover:text-terracotta"
                                >
                                    <svg
                                        class="w-4 h-4 text-ochre"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                        ></path>
                                    </svg>
                                    +33 7 64 44 37 15
                                </a>
                            </p>
                            <p>
                                <a
                                    href="mailto:atelier.ilys@gmail.com"
                                    class="flex items-center gap-2 hover:text-terracotta"
                                >
                                    <svg
                                        class="w-4 h-4 text-ochre"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                        ></path>
                                    </svg>
                                    atelier.ilys@gmail.com
                                </a>
                            </p>
                        </address>
                    </div>

                    <!-- Travel info -->
                    <div
                        class="bg-white p-6 rounded-sm shadow-sm border border-cream-dark"
                    >
                        <h3 class="font-heading text-lg text-indigo mb-4">
                            Getting here
                        </h3>
                        <p class="text-xs text-warm-text/60 mb-3">
                            Atelier Ilys · 1080 route de fontienne · 04300
                            Pierrerue
                        </p>
                        <ul class="space-y-1.5 text-sm text-warm-text/70">
                            <li>🚗 Aix-en-Provence: 1 hr 15 min</li>
                            <li>🚗 Marseille: 1 hr 30 min</li>
                            <li>🚗 Avignon: 1 hr 30 min</li>
                            <li>🚗 Manosque (railway station): 20 min</li>
                        </ul>
                        <p class="text-xs text-warm-text/50 mt-3">
                            Free parking on site. Car-sharing can be arranged on
                            request.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Map -->
    <section class="pb-16 bg-cream">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <GoogleMap height="400px" />
        </div>
    </section>
</BaseLayout>
