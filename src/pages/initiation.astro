---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkshopCard from "../components/WorkshopCard.astro";

const _uploads = import.meta.glob("../assets/optimized/uploads/**/*", {
    eager: true,
    as: "url",
});
const asset = (p: string): string =>
    (_uploads as Record<string, string>)[`../assets/optimized/uploads/${p}`] ??
    `https://atelier-ilys.com/wp-content/uploads/${p}`;

const workshops = [
    {
        type: "indigo",
        title: "Teinture à l'indigo",
        description:
            "L'indigo naturel, est la plus ancienne teinture connue. Apprenez à monter une cuve organique d'indigo, découvrez la magie de l'oxydation, et repartez avec vos créations bleues uniques. Stage à la demi-journée, journée complète ou plusieurs jours selon votre envie",
        details: "L’indigo est un pigment bleu qu’on extrait de plusieurs plantes: l’indigotier, le pastel ou la persicaire. Il est insoluble dans l’eau contrairement aux autres couleurs ce qui nécessite un procédé de teinture très particulier, le montage d'une cuve d'indigo. Les ateliers d'indigo permettent de découvrir et maîtriser l'art ancestral de la teinture à l'indigo, à transmettre une compréhension des processus chimiques naturels impliqués, tout en permettant à chacun de repartir avec des créations uniques et personnalisées.  demi journée  Le stage se déroule de 14h à 17h30. Vous allez dans un premier temps apprendre à utiliser une cuve d'indigo, puis réaliser différents échantillons avec des nuances de bleu et de motifs exécutés selon les techniques japonaises du Shibori. Puis vous teindrez une étole de coton avec motifs personnalisés.Isabelle vous guidera dans la réalisation des motifs et l'utilisation de la cuve d'indigo pour obtenir un bleu solide  et 100% naturel.journée entière  Les stages d'une journée démarrent à 9h30 avec le montage d'une cuve d'indigo qui va progressivement s'activer pour être prête à fonctionner l'après midi. Puis vous allez préparer une pâte de réserve à base d'argile pour réaliser des tests de motifs. Pendant que vos créations sèchent, Isabelle vous emmène au jardin pour apprendre à reconnaître les plantes à indigo (lorsque les plantes sont à maturité ) puis à vous donner quelques explications sur l'indigo et l'entretien de la cuve.L'après-midi est consacrée à la teinture. Vous allez dans un premier temps apprendre à utiliser une cuve d'indigo, puis réaliser différents échantillons dont un nuancier de bleu et des motifs exécutés selon les techniques japonaises du Shibori. Vous allez également teindre les motifs que vous aurez préparés le matin. Vous terminerez par la teinture de votre étole en coton personnalisée et toutes les finitions pour obtenir un bleu durable et 100% naturel .Vous repartez avec vos créations et la recette pour réaliser et entretenir une cuve à indigo journée entière fabrication de pigment d’indigo La journée commence par la cueillette des plantes au jardin. Puis retour à l'atelier pour le transformer en pigment d'indigo insoluble et comprendre sa formation. L'après-midi sera consacrée à l'utilisation de l'indigo avec le montage d'une petite cuve, la manipulation et l'expérimentation à partir de pigment d'indigo. Stage possible uniquement lorsque les persicaires à indigo sont en feuilles Tablier et gants sont fournis. Repas non fourni, apporter son pique nique relookez vos vêtements Vous souhaitez réaliser une création personnelle, isabelle peut vous aider à le réaliser à l'atelier. Vous pouvez amener vos propres vêtements blancs ou  acheter sur place l'étoffe de vos rêves . Devis sur demande, prix au poids du tissu à partir de 10€ les 100ggrands formatsLe stage permet d’apprendre à monter une cuve au fer , au henné ou cuve 1 2 3(100 litres minimum), de préparer les tissus grand format à la teinture, puis de teindre ses créations. Stage limité à 4 personnes. Possibilité d’apporter jusqu'à 2,5kg de linge, possibilité de dormir sur place (voir rubrique ‘dormir sur place’ sur le site).Tarif sur demandePour tous les stages, repas non fournis, thé et café en libre service, gants et tabliers sont prêtés",

        duration: "Journée complète (9h–17h)",
        price: "110 €",
        image: asset("initiation/shibori.jpg"),
        imageAlt: " la couleur verte qui vire au bleu par oxydation",
    },
    {
        type: "teinture",
        title: "Teinture végétale",
        description:
            "Plantes du jardin, cueillette sauvage, pelures d'oignons… Découvrez l'inépuisable palette des teintures végétales locales et apprenez à utiliser les mordants pour fixer les couleurs durablement.",
        details: "L'objectif des ateliers est d'initier les participants aux techniques traditionnelles de teinture utilisant des plantes locales, à sensibiliser à l'utilisation durable des ressources naturelles tout en permettant à chacun de créer des pièces uniques et personnalisées, teintées avec les couleurs de la nature. Les participants apprendront à extraire et à fixer des colorants naturels sur des textiles, découvrant ainsi un savoir-faire artisanal respectueux de l'environnement. Lorsque la saison et le temps le permettent vous irez cueillir les plantes au jardin pour les transformer en couleur et en faire de la teinture. Sinon Isabelle aura cueilli les plantes au meilleur de leur maturité, puis fait sécher et conserver à l'abri de l'humidité et de la lumière pour être à votre disposition à l'atelier.Demi journée teintureDurée du stage de 14h à 17h30, tarif 55 euros. L'atelier commence par le mordançage d'un foulard, c'est à dire mettre un apprêt pour que la couleur s'accroche au tissu en même temps que l'on prépare le bain de teinture et l'extraction de la couleur. Puis les participants vont créer des motifs sur les pièces à teindre selon la technique japonaise du shibori utiliser leur bain de teinture, et réaliser les finitionsIsabelle vous guidera dans la réalisation des motifs et la teinture pour que vous obteniez des couleurs éclatantes, solides, et naturelles.Une journée dans la teinture végétale Durée 6h, tarif 110 eurosLes plantes tinctoriales contiennent une palette de couleur infinie; à chaque plante une nuance unique.  Mais est ce que la couleur tient? Oui si le tissu est bien préparé à recevoir de la couleur.La matinée est consacrée à la préparation des tissus (décatissage, rinçage, mordançage), à la découverte de quelques plantes tinctoriales et des grandes familles de colorants naturels, puis la cueillette au jardin et la préparation des bains de teinture.Après la pause déjeuner sous le tilleul ou la terrasse, l'après-midi démarre par la teinture d'un nuancier de couleurs. Puis c’est le moment de teindre votre foulard. On prendra le temps de détailler l’ensemble des étapes, pour être capable de refaire les recettes utilisées. Isabelle vous guidera pour obtenir des couleurs solides  et éclatantes. Vous repartez avec vos créations Relookez vos vêtements avec les plantes du jardinVous souhaitez réaliser une création personnelle, Isabelle peut vous aider à le réaliser à l’atelier. Vous pouvez amener votre propre tissu, des vêtements blancs ou  acheter sur place l’étoffe de vos rêves . Devis sur demande à partir de 10€/100g",
        duration: "Journée complète (9h–17h)",
        price: "110 €",
        image: asset("2024/01/atelierteinture.jpg"),
        imageAlt:
            "Plusieurs fibres teintes avec des plantes naturelles — ocre, vert, rouille, rose",
    },
    {
        type: "ecoprint",
        title: "Écoprint",
        description:
            "La technique de l'écoprint consiste à imprimer directement les colorants des feuilles sur tissu ou papier par compression et chaleur. Chaque création est unique, un vrai tableau botanique que vous emportez chez vous.",
        details: "découverte 1/2journée Durée du stage de 14h à 17h30. Tarif 55 euros  Recréez l’atmosphère de la nature qui vous entoure en conservant une empreinte des plantes sur un foulard.L’atelier démarre par une cueillette des plantes au jardin avec quelques explications sur les plantes à tanins, qui rendent les empreintes plus visibles et délicates. Isabelle vous guidera pour sélectionner celles qui offrent les meilleures empreintes.Retour à l’atelier où les plantes sont disposées harmonieusement sur le foulard que vous aurez mordancé au préalable, c’est à dire imprégné d’un apprêt qui va permettre de fixer les couleurs durablement. Puis vous allez  confectionner de petits rouleaux serrés qui vont être cuits à la vapeur. Pendant la cuisson vous pourrez tester le tatakizome, cette technique japonaise qui permet l’impression de feuilles en révélant les tanins qu’elles contiennent.Ca y est votre foulard unique et personnalisé est prêt, vous ouvrez le petit rouleau et surprise! Mais on n’en dit pas plus …Vous repartez avec votre foulard imprimé avec des motifs solides.Possibilité de faire une journée entière avec la réalisation de 2 écoprint avec des techniques",
        duration: "Demi-journée (9h–12h30)",
        price: "55 €",
        image: asset("initiation/ecoprint.jpg"),
        imageAlt:
            "Empreintes de feuilles de printemps imprimées sur viscose par écoprint",
    },
    {
        type: "beaux arts",
        title: "Stage Beaux-Arts",
        description:
            "fabrication de pigments, encres, aquarelles et pastels naturels. Techniques avancées, extraction, conservation et applications créatives. Matériel fourni.",
        details: "Encres végétalesDurée du stage de 14h à 17h30. Tarif 55 euros Mettez-vous dans la peau des peintres du moyen-âge en créant vos encres végétales. Allez cueillir vos plantes au jardin et dans la garrigue environnante où avec Isabelle vous apprendrez à reconnaitre et cueillir les plantes qui donnent de la couleur. Puis retour à l’atelier pour extraire la couleur des plantes et en fabriquer des encres plus ou moins épaisses selon la façon dont on souhaite les utiliser. En fonction de la saison vous travaillerez avec des iris, des cosmos sulfureux, des camomilles des teinturiers, de la garance, du réséda, des noix de galle, etc …Isabelle vous guidera pour que vous obteniez des couleurs éclatantes, solides, et naturelles. Vous repartez avec 5 encres végétales et les recettes pour les refaire chez vous.  Couleurs beaux arts Durée 2 jours, tarif 220 euros. Les participants apprennent à fabriquer des couleurs naturelles pour les beaux-arts à partir de plantes et pigments minéraux locaux. Ils découvrent des techniques ancestrales de préparation d'encres et de peintures tout en créant des nuances uniques et écologiques. Le stage allie pratique artistique et respect de la nature dans un cadre inspirant. Ce stage se déroule sur 2 jours pendant lesquels vous apprendrez à réaliser vos propres couleurs à partir des plantes cueillies au jardin. La première matinée sera consacrée  à l'extraction de la couleur et à la préparation des pigments.  L’après-midi vous réaliserez une palette d’encres végétales. Les couleurs pourront varier selon les saisons. Les jours suivants vous poursuivrez le séchage et le broyage du pigment, puis vous apprendrez à fabriquer vos crayons de pastel secs et gras, vos aquarelles...",
        duration: "2 jours complets",
        price: "220 €",
        image: asset("2024/01/stagepigment.jpg"),
        imageAlt:
            "Pots de pigments naturels de différentes couleurs — ocre, orange, rouge — préparés à l'Atelier Ilys",
    },
    {
        type: "famille",
        title: "Atelier famille",
        description:
            "Un atelier ludique et pédagogique pour partager la magie des couleurs naturelles en famille. Les enfants comme les parents repartent émerveillés avec leurs créations teintes à la main. Accessible dès 6 ans.",
        details: "La première partie de l’atelier se déroule au jardin pour cueillir les plantes qui  seront utilisées pour extraire la couleur (lorsque la saison le permet).Puis retour à l’atelier pour un moment ludique à composer vos créations en famille selon la technique japonaise du shibori sur carrés de coton, qu’on ira plonger dans la teinture. Pendant que la teinture imprègne le tissu, prenez un moment pour en connaître un peu plus sur l’histoire de la teinture végétale.Enfin vos œuvres sont prêtes! Emerveillez -vous devant vos talents d’artistes à la sortie du bain de teinture, et repartez pleins de souvenirs avec vos œuvres  et les recettes utilisées.",
        duration: "Demi-journée (14h–16h30)",
        price: "35 € / personne",
        image: asset("initiation/famille.JPG"),
        imageAlt:
            "Enfants et parents lors d'un atelier famille de teinture végétale à l'Atelier Ilys",
    },
];

const eventLdItems = workshops.map((w, i) => ({
    "@context": "https://schema.org",
    "@type": "Event",
    name: `Stage ${w.title} — Atelier Ilys`,
    description: w.description,
    url: `https://atelier-ilys.com/reserver`,
    organizer: {
        "@type": "Organization",
        name: "Atelier Ilys",
        url: "https://atelier-ilys.com",
    },
    location: {
        "@type": "Place",
        name: "Atelier Ilys",
        address: {
            "@type": "PostalAddress",
            streetAddress: "1080 route de fontienne",
            addressLocality: "Pierrerue",
            postalCode: "04300",
            addressCountry: "FR",
        },
    },
    offers: {
        "@type": "Offer",
        price: w.price.replace(/[^0-9]/g, ""),
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
        url: "https://atelier-ilys.com/reserver",
    },
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
}));
---

<BaseLayout
    title="Stages de teinture végétale — Indigo, Plantes, Écoprint"
    description="Stages de teinture végétale artisanale à l'Atelier Ilys (Pierrerue, Haute-Provence) : indigo, plantes, écoprint, pigments, ateliers famille. Dès 35 €. Tous niveaux."
    canonicalPath="/initiation"
    jsonLd={eventLdItems}
>
    <!-- Hero -->
    <section class="py-20 bg-cream-dark border-b border-cream-dark">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-ochre text-sm uppercase tracking-widest mb-3">
                Découverte
            </p>
            <h1 class="section-title text-4xl md:text-5xl">
                Stages de teinture végétale
            </h1>
            <p class="section-subtitle">
                Tous niveaux · Petits groupes · Matériel fourni
            </p>
            <p class="text-warm-text/70 max-w-2xl mx-auto leading-relaxed">
                Que vous soyez curieux du vivant, artiste textile, enseignant ou
                simplement en quête d'une expérience créative authentique, nos
                stages sont faits pour vous. Isabelle Lys accueille de petits
                groupes pour une transmission personnalisée.
            </p>
        </div>
    </section>

    <!-- Pricing summary -->
    <section class="py-10 bg-indigo text-cream">
        <div class="max-w-7xl mx-auto px-4">
            <div
                class="flex flex-wrap justify-center gap-6 md:gap-12 text-center"
            >
                {
                    [
                        {
                            label: "Demi-journée",
                            price: "55 €",
                            detail: "3h30",
                        },
                        {
                            label: "Journée complète",
                            price: "110 €",
                            detail: "7h",
                        },
                        {
                            label: "Atelier famille",
                            price: "35 €",
                            detail: "2h30",
                        },
                    ].map(({ label, price, detail }) => (
                        <div class="px-4">
                            <p class="font-heading text-2xl text-ochre">
                                {price}
                            </p>
                            <p class="text-sm font-medium text-cream">
                                {label}
                            </p>
                            <p class="text-xs text-cream/60">{detail}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Workshop cards -->
    <section class="py-20 bg-cream">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {workshops.map((w) => <WorkshopCard {...w} />)}
            </div>
        </div>
    </section>

    <!-- What's included -->
    <section class="py-20 bg-white">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <h2 class="section-title mb-3">Ce qui est inclus</h2>
            <p class="section-subtitle">
                Tout le nécessaire pour apprendre et créer
            </p>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mt-10 text-left">
                {
                    [
                        {
                            icon: "🧪",
                            label: "Matières premières",
                            detail: "Plantes, mordants, fibres",
                        },
                        {
                            icon: "🥣",
                            label: "Cuves et équipement",
                            detail: "Fourni par l'atelier",
                        },
                        {
                            icon: "📋",
                            label: "Supports pédagogiques",
                            detail: "Fiches techniques remises",
                        },
                        {
                            icon: "☕",
                            label: "Accueil café/thé",
                            detail: "Boissons chaudes offertes",
                        },
                        {
                            icon: "🎨",
                            label: "Vos créations",
                            detail: "Vous repartez avec vos œuvres",
                        },
                        {
                            icon: "👥",
                            label: "Petit groupe",
                            detail: "Max. 8–10 personnes",
                        },
                    ].map(({ icon, label, detail }) => (
                        <div class="flex gap-3 items-start">
                            <span class="text-2xl">{icon}</span>
                            <div>
                                <p class="font-semibold text-sm text-warm-text">
                                    {label}
                                </p>
                                <p class="text-xs text-warm-text/60">
                                    {detail}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-ochre text-cream text-center">
        <div class="max-w-2xl mx-auto px-4">
            <h2 class="font-heading text-3xl text-cream mb-4">
                Prêt(e) à vous lancer ?
            </h2>
            <p class="text-cream/90 mb-8">
                Consultez le calendrier des dates disponibles ou envoyez-nous
                une demande pour un stage sur mesure.
            </p>
            <div class="flex flex-wrap justify-center gap-4">
                <a
                    href="/planifiez"
                    class="btn-primary bg-cream text-ochre hover:bg-cream-dark"
                    >Voir le calendrier</a
                >
                <a
                    href="/reserver"
                    class="btn-secondary border-cream text-cream hover:bg-cream hover:text-ochre"
                    >Réserver un stage</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
