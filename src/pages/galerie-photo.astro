---
import BaseLayout from "../layouts/BaseLayout.astro";
import Gallery from "../components/Gallery.astro";
const _uploads = import.meta.glob('../assets/optimized/uploads/**/*', { eager: true, as: 'url' })

const galleryImages = (folder: string) =>
    Object.entries(_uploads as Record<string, string>)
        .filter(([k]) => k.includes(`/uploads/galeriephoto/${folder}/`))
        .map(([k, v]) => ({
            src: v,
            alt: k.split('/').pop()?.replace(/\.[^.]+$/, '').replace(/[-_]/g, ' ') ?? folder,
        }))

const gallerySections = [
    { id: "le-lieu",              title: "Le lieu — La magnanerie", images: galleryImages("le lieu") },
    { id: "l-atelier",            title: "L'atelier",               images: galleryImages("l'atelier") },
    { id: "le-jardin",            title: "Le jardin",               images: galleryImages("le jardin tinctorial") },
    { id: "les-stages",           title: "Les stages",              images: galleryImages("les stages") },
    { id: "les-creations",        title: "Les créations",           images: galleryImages("les créations") },
    { id: "service-personnalise", title: "Service personnalisé",    images: galleryImages("service personnalisé") },
    { id: "dormir-sur-place",     title: "Dormir sur place",        images: galleryImages("dormir sur place") },
]
---

<BaseLayout
    title="Galerie photos — L'atelier, les stages et l'hébergement"
    description="Galerie photos de l'Atelier Ilys : le lieu, l'atelier et le jardin, les stages de teinture végétale, les créations, le service personnalisé et l'hébergement à Pierrerue."
    canonicalPath="/galerie-photo"
>
    <section class="py-16 bg-cream-dark border-b text-center">
        <div class="max-w-3xl mx-auto px-4">
            <p class="text-ochre text-sm uppercase tracking-widest mb-3">
                Galerie
            </p>
            <h1 class="section-title text-4xl md:text-5xl">Photos</h1>
            <p class="text-warm-text/70 mt-4">
                Découvrez en images le domaine, l'atelier, le jardin tinctorial, les stages et les
                créations de l'Atelier Ilys.
            </p>
        </div>
    </section>

    <section class="py-12 bg-cream">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
            <Gallery sections={gallerySections} />
        </div>
    </section>

    <section class="py-12 bg-indigo text-center text-cream">
        <div class="max-w-2xl mx-auto px-4">
            <h2 class="font-heading text-2xl text-cream mb-4">
                Vous aussi, vivez l'expérience
            </h2>
            <div class="flex flex-wrap justify-center gap-4">
                <a href="/initiation" class="btn-ochre">Voir les stages</a>
                <a
                    href="/sejournez"
                    class="btn-secondary border-cream text-cream hover:bg-cream hover:text-indigo"
                    >Séjourner sur place</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
