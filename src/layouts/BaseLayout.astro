---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import { getLang, stripLang, localizePath, useTranslations } from "../i18n";

interface Props {
    title: string;
    description: string;
    image?: string;
    canonicalPath?: string;
    jsonLd?: object | object[];
    background?: string;
}

const {
    title,
    description,
    image = "/images/og-default.jpg",
    background,
    canonicalPath = "",
    jsonLd,
} = Astro.props;

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const basePath = stripLang(Astro.url.pathname);
const siteUrl = "https://atelier-ilys.com";
const homeUrl = `${siteUrl}${localizePath("/", lang)}`;
const altUrls = {
    fr: `${siteUrl}${localizePath(basePath, "fr")}`,
    en: `${siteUrl}${localizePath(basePath, "en")}`,
};
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const ogImage = image.startsWith("http") ? image : `${siteUrl}${image}`;

const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Breadcrumb JSON-LD
const isHome = basePath === "/";
const breadcrumbItems = !isHome
    ? [
          { "@type": "ListItem", position: 1, name: t("site.home"), item: homeUrl },
          { "@type": "ListItem", position: 2, name: title, item: canonicalUrl },
      ]
    : [{ "@type": "ListItem", position: 1, name: t("site.home"), item: homeUrl }];

const breadcrumbLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems,
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />

        <title>{title} | Atelier Ilys</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang="fr" href={altUrls.fr} />
        <link rel="alternate" hreflang="en" href={altUrls.en} />
        <link rel="alternate" hreflang="x-default" href={altUrls.fr} />

        <!--
            Language auto-detection: on the very first visit only, visitors whose
            browser is not set to French are sent to the English version.
            Once a language is chosen (detected or via the FR/EN switch) it is
            remembered in localStorage and never overridden. Bots are skipped so
            that search engines index both versions.
        -->
        <script is:inline>
            (function () {
                try {
                    if (/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)) return;
                    if (localStorage.getItem("lang")) return;
                    var langs = navigator.languages || [navigator.language || ""];
                    var pref = String(langs[0] || "").toLowerCase().indexOf("fr") === 0 ? "fr" : "en";
                    localStorage.setItem("lang", pref);
                    var p = location.pathname;
                    var isEn = p === "/en" || p.indexOf("/en/") === 0;
                    if (pref === "en" && !isEn) {
                        location.replace((p === "/" ? "/en/" : "/en" + p) + location.search + location.hash);
                    }
                } catch (e) {}
            })();
        </script>

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={`${title} | Atelier Ilys`} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:locale" content={lang === "en" ? "en_GB" : "fr_FR"} />
        <meta property="og:locale:alternate" content={lang === "en" ? "fr_FR" : "en_GB"} />
        <meta property="og:site_name" content="Atelier Ilys" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={`${title} | Atelier Ilys`} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <!-- Favicon -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <!-- JSON-LD Structured Data -->
        {
            jsonLdArray.map((schema) => (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(schema)}
                />
            ))
        }
        <script
            type="application/ld+json"
            set:html={JSON.stringify(breadcrumbLd)}
        />
    </head>
    <body
        class="min-h-screen flex flex-col"
        style={background
            ? `background-image:url('${background}');background-size:cover;background-position:center;`
            : undefined}
    >
        <Header />
        <main class="flex-1">
            <slot />
        </main>
        <Footer />
        <Analytics />
    </body>
</html>
