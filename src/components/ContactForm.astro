---
import { getLang, useTranslations } from '../i18n'

interface Props {
  formId?: string
  successMessage?: string
}

const lang = getLang(Astro.url)
const t = useTranslations(lang)

const {
  formId = 'contact-form',
  successMessage = t('contact.success'),
} = Astro.props

const labels = {
  sending: t('form.sending'),
  submit: t('contact.send'),
  error: t('form.error'),
}
---

<form
  id={formId}
  method="POST"
  action="/api/contact"
  class="space-y-5"
  novalidate
>
  <input type="hidden" name="lang" value={lang} />
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for={`${formId}-name`} class="form-label">{t("form.name")} <span class="text-terracotta">*</span></label>
      <input
        type="text"
        id={`${formId}-name`}
        name="name"
        required
        autocomplete="name"
        class="form-input"
        placeholder={t("form.namePlaceholder")}
      />
    </div>
    <div>
      <label for={`${formId}-email`} class="form-label">{t("form.email")} <span class="text-terracotta">*</span></label>
      <input
        type="email"
        id={`${formId}-email`}
        name="email"
        required
        autocomplete="email"
        class="form-input"
        placeholder={t("form.emailPlaceholder")}
      />
    </div>
  </div>

  <div>
    <label for={`${formId}-phone`} class="form-label">{t("form.phone")}</label>
    <input
      type="tel"
      id={`${formId}-phone`}
      name="phone"
      autocomplete="tel"
      class="form-input"
      placeholder={t("form.phonePlaceholder")}
    />
  </div>

  <div>
    <label for={`${formId}-message`} class="form-label">{t("contact.message")} <span class="text-terracotta">*</span></label>
    <textarea
      id={`${formId}-message`}
      name="message"
      required
      rows="5"
      class="form-input resize-y"
      placeholder={t("contact.messagePlaceholder")}
    ></textarea>
  </div>

  <!-- Honeypot anti-spam -->
  <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

  <div id={`${formId}-status`} class="hidden" role="alert" aria-live="polite"></div>

  <button type="submit" class="btn-primary w-full sm:w-auto" id={`${formId}-submit`}>
    {t('contact.send')}
  </button>
</form>

<script define:vars={{ formId, successMessage, labels }}>
  const form = document.getElementById(formId)
  const status = document.getElementById(`${formId}-status`)
  const submit = document.getElementById(`${formId}-submit`)

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    if (!form || !status || !submit) return

    // Honeypot check
    const honey = form.querySelector('[name="_honey"]')
    if (honey && honey.value) return

    submit.setAttribute('disabled', 'true')
    submit.textContent = labels.sending
    status.className = 'hidden'

    try {
      const formData = new FormData(form)
      const payload = Object.fromEntries(formData.entries())
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      const data = await res.json()

      if (res.ok && data.ok) {
        status.textContent = successMessage
        status.className = 'p-4 bg-botanical/10 border border-botanical text-botanical rounded text-sm'
        form.reset()
      } else {
        throw new Error(data.error || 'Erreur')
      }
    } catch (err) {
      status.textContent = labels.error
      status.className = 'p-4 bg-terracotta/10 border border-terracotta text-terracotta rounded text-sm'
    } finally {
      submit.removeAttribute('disabled')
      submit.textContent = labels.submit
      status.classList.remove('hidden')
      status.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
    }
  })
</script>
