---
interface Props {
    title?: string;
    height?: string;
}

const { title = "Atelier Ilys — Pierrerue, Haute-Provence", height = "400px" } =
    Astro.props;

// Embedded Google Maps for Pierrerue / Forcalquier area
const mapSrc =
    "https://maps.google.com/maps?width=100%&amp;height=100%&amp;hl=en&amp;q=1080 route de fontienne&amp;t=&amp;z=14&amp;ie=UTF8&amp;iwloc=B&amp;output=embed";
---

<h2 class="text-center text-2xl font-semibold mb-4 text-indigo">
    Où se trouve Atelier Ilys ?
</h2>
<div
    class="relative rounded-sm overflow-hidden border-4 border-ochre shadow-lg"
>
    <!-- optional pin icon overlay -->
    <div class="absolute top-2 right-2 bg-ochre text-indigo rounded-full p-2">
        📍
    </div>
    <iframe
        src={mapSrc}
        width="100%"
        height={height}
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={title}
        aria-label={title}></iframe>
</div>
<p class="text-xs text-warm-text/50 mt-2 text-center">
    Atelier Ilys · 1080 route de fontienne · 04300 Pierrerue (Forcalquier)
</p>
