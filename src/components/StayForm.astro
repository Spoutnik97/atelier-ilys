---
import { getLang, useTranslations } from '../i18n'

const lang = getLang(Astro.url)
const t = useTranslations(lang)
const en = lang === 'en'

// Values stay in French (they end up in the email sent to the atelier)
const rooms = [
  { value: 'Maisonnette (2 personnes)', en: 'Maisonnette (2 people)' },
  { value: 'Le Grand Pré Loft (2–12 personnes)', en: 'Le Grand Pré Loft (2–12 people)' },
  { value: 'Chambre Azur', en: 'Azur room' },
  { value: 'Chambre Verte', en: 'Green room' },
  { value: 'Chambre Rose', en: 'Pink room' },
  { value: 'Chambre Grenade', en: 'Grenade room' },
  { value: 'À définir / Je ne sais pas encore', en: 'Not sure yet' },
]
---

<form
  id="stay-form"
  method="POST"
  action="/api/booking-stay"
  class="space-y-5"
  novalidate
  data-sending={t('form.sending')}
  data-submit={t('form.sendRequest')}
  data-success={t('stay.success')}
  data-error={t('form.error')}
>
  <input type="hidden" name="lang" value={lang} />
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for="stay-name" class="form-label">{t("form.name")} <span class="text-terracotta">*</span></label>
      <input
        type="text"
        id="stay-name"
        name="name"
        required
        autocomplete="name"
        class="form-input"
        placeholder={t("form.namePlaceholder")}
      />
    </div>
    <div>
      <label for="stay-email" class="form-label">{t("form.email")} <span class="text-terracotta">*</span></label>
      <input
        type="email"
        id="stay-email"
        name="email"
        required
        autocomplete="email"
        class="form-input"
        placeholder={t("form.emailPlaceholder")}
      />
    </div>
  </div>

  <div>
    <label for="stay-phone" class="form-label">{t("form.phone")} <span class="text-terracotta">*</span></label>
    <input
      type="tel"
      id="stay-phone"
      name="phone"
      required
      autocomplete="tel"
      class="form-input"
      placeholder={t("form.phonePlaceholder")}
    />
  </div>

  <div>
    <label for="stay-room" class="form-label">{t("stay.room")} <span class="text-terracotta">*</span></label>
    <select id="stay-room" name="room" required class="form-input">
      <option value="">{t('stay.roomChoose')}</option>
      {rooms.map((r) => <option value={r.value}>{en ? r.en : r.value}</option>)}
    </select>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for="stay-arrival" class="form-label">{t("stay.arrival")} <span class="text-terracotta">*</span></label>
      <input
        type="date"
        id="stay-arrival"
        name="arrivalDate"
        required
        class="form-input"
      />
    </div>
    <div>
      <label for="stay-departure" class="form-label">{t("stay.departure")} <span class="text-terracotta">*</span></label>
      <input
        type="date"
        id="stay-departure"
        name="departureDate"
        required
        class="form-input"
      />
    </div>
  </div>

  <div>
    <label for="stay-guests" class="form-label">{t("stay.guests")} <span class="text-terracotta">*</span></label>
    <input
      type="number"
      id="stay-guests"
      name="guests"
      required
      min="1"
      max="20"
      class="form-input"
      placeholder="2"
    />
  </div>

  <div>
    <label for="stay-message" class="form-label">{t("stay.message")}</label>
    <textarea
      id="stay-message"
      name="message"
      rows="4"
      class="form-input resize-y"
      placeholder={t("stay.messagePlaceholder")}
    ></textarea>
  </div>

  <!-- Honeypot -->
  <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

  <div id="stay-status" class="hidden" role="alert" aria-live="polite"></div>

  <button type="submit" class="btn-primary w-full sm:w-auto" id="stay-submit">
    {t('form.sendRequest')}
  </button>
  <p class="text-xs text-warm-text/50">{t("stay.note")}</p>
</form>

<script>
  const form = document.getElementById('stay-form') as HTMLFormElement | null
  const status = document.getElementById('stay-status')
  const submit = document.getElementById('stay-submit')

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    if (!form || !status || !submit) return

    const honey = form.querySelector('[name="_honey"]') as HTMLInputElement
    if (honey?.value) return

    submit.setAttribute('disabled', 'true')
    submit.textContent = form.dataset.sending || ''
    status.className = 'hidden'

    try {
      const formData = new FormData(form)
      const payload = Object.fromEntries(formData.entries())
      const res = await fetch('/api/booking-stay', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      const data = await res.json()

      if (res.ok && data.ok) {
        status.textContent = form.dataset.success || ''
        status.className = 'p-4 bg-botanical/10 border border-botanical text-botanical rounded text-sm'
        form.reset()
      } else {
        throw new Error(data.error || 'Erreur')
      }
    } catch {
      status.textContent = form.dataset.error || ''
      status.className = 'p-4 bg-terracotta/10 border border-terracotta text-terracotta rounded text-sm'
    } finally {
      submit.removeAttribute('disabled')
      submit.textContent = form.dataset.submit || ''
      status.classList.remove('hidden')
      status.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
    }
  })
</script>
