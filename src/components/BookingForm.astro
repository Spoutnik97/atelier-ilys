---
import { getLang, localizePath, useTranslations } from '../i18n'

const lang = getLang(Astro.url)
const t = useTranslations(lang)
const en = lang === 'en'

// Values stay in French (they end up in the email sent to the atelier)
const workshopTypes = [
  { value: 'Teinture à l\'indigo', en: 'Indigo dyeing' },
  { value: 'Teinture végétale', en: 'Plant dyeing' },
  { value: 'Pigments et encres naturelles', en: 'Natural pigments and inks' },
  { value: 'Écoprint', en: 'Eco-print' },
  { value: 'Atelier famille', en: 'Family workshop' },
  { value: 'Beaux-arts (pigments)', en: 'Fine arts (pigments)' },
  { value: 'Stage personnalisé', en: 'Custom workshop' },
]

const durations = [
  { value: 'demi-journee', fr: 'Demi-journée (2h30) — 60 €', en: 'Half day (2.5 h) — €60' },
  { value: 'journee', fr: 'Journée complète — 120 €', en: 'Full day — €120' },
  { value: '2-jours', fr: '2 jours — 240 €', en: '2 days — €240' },
  { value: 'famille', fr: 'Atelier famille (2h30) — 40 € / adulte', en: 'Family workshop (2.5 h) — €40 / adult' },
]
---

<form
  id="booking-form"
  method="POST"
  action="/api/booking-workshop"
  class="space-y-5"
  novalidate
  data-sending={t('form.sending')}
  data-submit={t('form.sendRequest')}
  data-success={t('booking.success')}
  data-error={t('form.error')}
>
  <input type="hidden" name="lang" value={lang} />
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for="booking-name" class="form-label">{t("form.name")} <span class="text-terracotta">*</span></label>
      <input
        type="text"
        id="booking-name"
        name="name"
        required
        autocomplete="name"
        class="form-input"
        placeholder={t("form.namePlaceholder")}
      />
    </div>
    <div>
      <label for="booking-email" class="form-label">{t("form.email")} <span class="text-terracotta">*</span></label>
      <input
        type="email"
        id="booking-email"
        name="email"
        required
        autocomplete="email"
        class="form-input"
        placeholder={t("form.emailPlaceholder")}
      />
    </div>
  </div>

  <div>
    <label for="booking-phone" class="form-label">{t("form.phone")} <span class="text-terracotta">*</span></label>
    <input
      type="tel"
      id="booking-phone"
      name="phone"
      required
      autocomplete="tel"
      class="form-input"
      placeholder={t("form.phonePlaceholder")}
    />
  </div>

  <div>
    <label for="booking-type" class="form-label">{t("booking.type")} <span class="text-terracotta">*</span></label>
    <select id="booking-type" name="workshopType" required class="form-input">
      <option value="">{t('booking.typeChoose')}</option>
      {workshopTypes.map((w) => <option value={w.value}>{en ? w.en : w.value}</option>)}
    </select>
  </div>

  <div>
    <label for="booking-duration" class="form-label">{t("booking.duration")} <span class="text-terracotta">*</span></label>
    <select id="booking-duration" name="duration" required class="form-input">
      <option value="">{t('booking.durationChoose')}</option>
      {durations.map((d) => <option value={d.value}>{en ? d.en : d.fr}</option>)}
    </select>
  </div>

  <div>
    <label for="booking-date" class="form-label">{t("booking.date")} <span class="text-terracotta">*</span></label>
    <input
      type="text"
      id="booking-date"
      name="preferredDate"
      required
      class="form-input"
      placeholder={t("booking.datePlaceholder")}
    />
    <p class="text-xs text-warm-text/50 mt-1">{t('booking.dateHintBefore')} <a href={localizePath('/planifiez', lang)} class="underline">{t('booking.dateHintLink')}</a> {t('booking.dateHintAfter')}</p>
  </div>

  <div>
    <label for="booking-participants" class="form-label">{t("booking.participants")}</label>
    <input
      type="number"
      id="booking-participants"
      name="participants"
      min="1"
      max="20"
      class="form-input"
      placeholder="1"
    />
  </div>

  <div>
    <label for="booking-wishes" class="form-label">{t("booking.wishes")}</label>
    <textarea
      id="booking-wishes"
      name="wishes"
      rows="4"
      class="form-input resize-y"
      placeholder={t("booking.wishesPlaceholder")}
    ></textarea>
  </div>

  <!-- Honeypot -->
  <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

  <div id="booking-status" class="hidden" role="alert" aria-live="polite"></div>

  <button type="submit" class="btn-primary w-full sm:w-auto" id="booking-submit">
    {t('form.sendRequest')}
  </button>
  <p class="text-xs text-warm-text/50">{t("booking.note")}</p>
</form>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null
  const status = document.getElementById('booking-status')
  const submit = document.getElementById('booking-submit')

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    if (!form || !status || !submit) return

    const honey = form.querySelector('[name="_honey"]') as HTMLInputElement
    if (honey?.value) return

    submit.setAttribute('disabled', 'true')
    submit.textContent = form.dataset.sending || ''
    status.className = 'hidden'

    try {
      const formData = new FormData(form)
      const payload = Object.fromEntries(formData.entries())
      const res = await fetch('/api/booking-workshop', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      const data = await res.json()

      if (res.ok && data.ok) {
        status.textContent = form.dataset.success || ''
        status.className = 'p-4 bg-botanical/10 border border-botanical text-botanical rounded text-sm'
        form.reset()
      } else {
        throw new Error(data.error || 'Erreur')
      }
    } catch {
      status.textContent = form.dataset.error || ''
      status.className = 'p-4 bg-terracotta/10 border border-terracotta text-terracotta rounded text-sm'
    } finally {
      submit.removeAttribute('disabled')
      submit.textContent = form.dataset.submit || ''
      status.classList.remove('hidden')
      status.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
    }
  })
</script>
